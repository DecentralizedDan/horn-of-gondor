{
  "name": "horn-of-gondor",
  "version": "0.1.0",
  "private": true,
  "description": "A VHF signal-reporting receiver for testing handheld amateur radios.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DecentralizedDan/horn-of-gondor.git"
  },
  "bugs": {
    "url": "https://github.com/DecentralizedDan/horn-of-gondor/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run receiver:test && npm run deploy:dry-run",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply horn-of-gondor --local",
    "db:migrate:remote": "wrangler d1 migrations apply horn-of-gondor --remote",
    "receiver:test": "npm --prefix receiver test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
